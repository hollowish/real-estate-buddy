{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Listing",
  "description": "A real estate listing saved by a user in Real Estate Buddy",
  "type": "object",
  "required": ["listingId", "userId", "address", "price", "createdAt"],
  "properties": {
    "listingId": {
      "type": "string",
      "description": "UUID generated server-side"
    },
    "userId": {
      "type": "string",
      "description": "Cognito sub (from JWT token, never from client)"
    },
    "address": {
      "type": "string",
      "description": "Full property address"
    },
    "price": {
      "type": "number",
      "description": "Listing price in USD"
    },
    "bedrooms": {
      "type": "integer"
    },
    "bathrooms": {
      "type": "number"
    },
    "sqft": {
      "type": "integer"
    },
    "mlsNumber": {
      "type": "string",
      "description": "Optional MLS reference number"
    },
    "userNotes": {
      "type": "string",
      "description": "Free-text notes from the user"
    },
    "userRating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "photos": {
      "type": "array",
      "items": { "type": "string" },
      "description": "S3 keys for uploaded photos"
    },
    "aiScore": {
      "type": ["number", "null"],
      "minimum": 1,
      "maximum": 100,
      "description": "AI-generated score (null until scored)"
    },
    "aiAnalysis": {
      "type": ["object", "null"],
      "properties": {
        "pros": { "type": "array", "items": { "type": "string" } },
        "cons": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      },
      "description": "AI-generated analysis (null until scored)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
